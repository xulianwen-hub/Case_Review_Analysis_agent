# ============================================================
# LLM 多厂商配置
# ============================================================

# 默认使用的 LLM 厂商: deepseek | doubao | qwen
LLM_PROVIDER=deepseek

# 自动降级链路：主模型不可用时，按此顺序依次尝试备选模型
# 多个厂商用逗号分隔，例如：deepseek,doubao,qwen
LLM_FALLBACK_CHAIN=deepseek,doubao,qwen

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 豆包 (火山引擎 Ark) ----------
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428

# ---------- 千问 (DashScope) ----------
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-turbo

# ============================================================
# 应用配置
# ============================================================
APP_ENV=development
LOG_LEVEL=INFO

# ============================================================
# 断路器 & 超时配置（生产环境调优）
# ============================================================

# 各厂商请求超时（秒），根据实际响应速度调整
DEEPSEEK_TIMEOUT=30
DOUBAO_TIMEOUT=60
QWEN_TIMEOUT=30

# 断路器：连续失败 N 次触发熔断
CB_FAILURE_THRESHOLD=3

# 断路器：熔断后 N 秒进入半开试探
CB_RECOVERY_TIMEOUT=30